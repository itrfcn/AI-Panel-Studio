# ============================================================
# AI Panel Studio - Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- LLM Provider (示例：兼容 OpenAI 协议的任意厂商) ---
# 大模型 API Key，仅在后端读取，不得暴露到浏览器端（PRD §7 安全要求）
LLM_API_KEY=sk-replace-me-with-real-key

# 大模型 Base URL（兼容 OpenAI 协议的厂商，可改：DeepSeek / Moonshot / 智谱 / OpenAI）
LLM_BASE_URL=https://api.deepseek.com/v1

# 大模型名称（用于 chat completions）
LLM_MODEL=deepseek-chat

# 模型温度（阵容生成 0.8 / 发言 0.7 / 抽取 0.3，由各 Agent 自行覆盖）
LLM_TEMPERATURE=0.7

# --- App ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (SQLite) ---
# 默认放 backend 目录下，生产可改绝对路径
DATABASE_URL=sqlite:///./ai_panel_studio.db

# --- 业务可调参数（对齐 PRD §3.3 调度策略，均可留空用默认值）---
# 每位 Agent 读取最近 K 条发言作为上下文
AGENT_CONTEXT_WINDOW_K=8
# 专家人数默认值与上下限
DEFAULT_EXPERT_COUNT=4
MIN_EXPERT_COUNT=2
MAX_EXPERT_COUNT=6
# 专家发言最大轮次，达到后主持人强制收尾
MAX_TURNS=8
# 触发共识/分歧抽取的最少发言条数
EXTRACTION_MIN_TRANSCRIPTS=2
