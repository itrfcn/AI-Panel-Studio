# ============================================================
# AI Panel Studio — 仓库级忽略规则
# 子目录 backend/.gitignore 与 frontend/.gitignore 为各自栈的补充
# ============================================================

# --- 机密（绝不提交）---
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- 虚拟环境 ---
venv/
.venv/
env/
ENV/

# --- SQLite 数据库 ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Node / 前端 ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 测试与覆盖率 ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- 编辑器 / 操作系统 ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- 工具产物 ---
.trae/
*.log
